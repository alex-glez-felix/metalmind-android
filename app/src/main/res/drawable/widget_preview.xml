<?xml version="1.0" encoding="utf-8"?>
<!--
    Vista previa del widget para los selectores que no usan previewLayout
    (Android 10 y 11, y algunos launchers de fabricante): la barra con el
    lápiz y una raya en lugar del texto, en vez del ícono de la app.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="280dp"
        android:height="56dp"
        android:drawable="@drawable/widget_background" />
    <item
        android:width="24dp"
        android:height="24dp"
        android:drawable="@drawable/ic_capture"
        android:gravity="start|center_vertical"
        android:start="16dp" />
    <item
        android:width="132dp"
        android:height="10dp"
        android:gravity="start|center_vertical"
        android:start="52dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_text_placeholder" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
