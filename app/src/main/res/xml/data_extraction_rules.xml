<?xml version="1.0" encoding="utf-8"?>
<!-- Nada que respaldar: lo único guardado es el permiso a una carpeta de este dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
